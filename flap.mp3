html, input, button, textarea { color: rgb(25, 27, 38); font-family: "Open =
Sans", Arial, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Rob=
oto, "Noto Sans", Ubuntu, Cantarell, "Helvetica Neue"; }

body, label, button, input, textarea { font-size: 14px; font-weight: 400; }

@media (max-width: 768px) {
  input, textarea { font-size: 16px; line-height: 20px; }
  input::-webkit-input-placeholder { font-size: 14px; line-height: 20px; }
  input::placeholder { font-size: 14px; line-height: 20px; }
  textarea::-webkit-input-placeholder { font-size: 14px; line-height: 20px;=
 }
  textarea::placeholder { font-size: 14px; line-height: 20px; }
}

body { color: rgb(25, 27, 38); padding-right: 0px; padding-bottom: 0px; pad=
ding-left: 0px; padding-top: env(safe-area-inset-top); }

a { color: rgb(0, 171, 107); text-decoration: none; }

a:hover { color: rgb(20, 188, 125); text-decoration: underline; }

table { border-collapse: collapse; }

table th { text-align: center; border: 1px solid rgba(25, 27, 38, 0.08); pa=
dding: 8px; font-weight: 600; }

table td { text-align: center; border: 1px solid rgba(25, 27, 38, 0.08); pa=
dding: 8px; }

table tfoot td { border-top: 2px solid rgba(25, 27, 38, 0.64); }

h1 { font-size: 32px; font-weight: 700; }

h2 { color: rgba(25, 27, 38, 0.64); font-size: 24px; font-weight: 600; }

hr { border-style: solid; border-color: rgba(25, 27, 38, 0.08); border-top-=
width: 0px; margin: 16px 0px; }

input[type=3D"search"]::-webkit-search-decoration { appearance: none; }

input[type=3D"search"]::-webkit-search-cancel-button { appearance: none; }

input[type=3D"search"]::-webkit-search-results-button { appearance: none; }

input[type=3D"search"]::-webkit-search-results-decoration { appearance: non=
e; }

.grecaptcha-badge { visibility: hidden; }

#ot-sdk-btn-floating { display: none !important; }

.hidden { visibility: hidden; width: 1px; height: 1px; position: absolute; =
}

