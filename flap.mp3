*, ::before, ::after { box-sizing: border-box; }

::before, ::after { text-decoration: inherit; vertical-align: inherit; }

:where(:root) { cursor: default; overflow-wrap: break-word; tab-size: 4; -w=
ebkit-tap-highlight-color: transparent; text-size-adjust: 100%; line-height=
: 1.5; }

:where(body) { margin: 0px; }

:where(h1) { margin: 0.67em 0px; font-size: 2em; }

:where(dl, ol, ul) :where(dl, ol, ul) { margin: 0px; }

:where(hr) { color: inherit; height: 0px; }

:where(nav) :where(ol, ul) { padding: 0px; list-style-type: none; }

:where(pre) { font-family: monospace; font-size: 1em; overflow: auto; }

:where(b, strong) { font-weight: bolder; }

:where(code, kbd, samp) { font-family: monospace; font-size: 1em; }

:where(small) { font-size: 80%; }

:where(audio, canvas, iframe, img, svg, video) { vertical-align: middle; }

:where(iframe) { border-style: none; }

:where(svg:not([fill])) { fill: currentcolor; }

:where(table) { border-collapse: collapse; border-color: inherit; text-inde=
nt: 0px; }

:where(button, [type=3D"button" i], [type=3D"reset" i], [type=3D"submit" i]=
) { appearance: button; }

:where(fieldset) { border: 1px solid rgb(160, 160, 160); }

:where(progress) { vertical-align: baseline; }

:where(textarea) { resize: vertical; margin: 0px; }

:where([type=3D"search" i]) { appearance: textfield; }

::-webkit-input-placeholder { color: inherit; opacity: 0.54; }

::-webkit-search-decoration { appearance: none; }

::-webkit-file-upload-button { appearance: button; }

:where(dialog) { color: rgb(0, 0, 0); height: fit-content; background-color=
: rgb(255, 255, 255); border: solid; width: fit-content; margin: auto; padd=
ing: 1em; position: absolute; left: 0px; right: 0px; }

:where(dialog:not([open])) { display: none; }

:where(details > summary:first-of-type) { display: list-item; }

:where([aria-busy=3D"true" i]) { cursor: progress; }

:where([aria-controls]) { cursor: pointer; }

:where([aria-disabled=3D"true" i], [disabled]) { cursor: not-allowed; }

:where([aria-hidden=3D"false" i][hidden]) { display: initial; }

:where([aria-hidden=3D"false" i][hidden]:not(:focus)) { clip: rect(0px, 0px=
, 0px, 0px); position: absolute; }

